# Database Configuration (PostgreSQL with pgvector)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/ai_study_assistant

# JWT Authentication
JWT_SECRET_KEY=change_this_to_a_secure_random_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25

# CORS Origins (comma-separated, explicit origins for production)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Google Gemini API & RAG Configuration
GEMINI_API_KEY=your_gemini_api_key_here
EMBEDDING_MODEL=models/text-embedding-004
EMBEDDING_DIMENSION=768
GEMINI_MODEL=gemini-2.5-flash
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5
